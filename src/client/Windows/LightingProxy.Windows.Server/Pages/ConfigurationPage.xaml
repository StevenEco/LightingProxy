<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LightingProxy.Windows.Server.Pages.ConfigurationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="960">
            <TextBlock Text="配置来源" Style="{StaticResource TitleTextBlockStyle}" />

            <ComboBox x:Name="StorageBox" Header="存储方式" SelectedIndex="0" SelectionChanged="StorageBox_SelectionChanged">
                <ComboBoxItem Content="本地文件" />
                <ComboBoxItem Content="数据库" />
            </ComboBox>

            <StackPanel x:Name="FilePanel" Spacing="12">
                <ComboBox x:Name="FileFormatBox" Header="文件格式" SelectedIndex="0">
                    <ComboBoxItem Content="JSON" />
                    <ComboBoxItem Content="INI" />
                </ComboBox>
                <TextBox Header="文件路径" Text="{x:Bind ViewModel.FilePath, Mode=TwoWay}" />
                <Button Content="浏览文件..." Click="BrowseFile_Click" HorizontalAlignment="Left" />
            </StackPanel>

            <StackPanel x:Name="DatabasePanel" Spacing="12" Visibility="Collapsed">
                <ComboBox x:Name="DatabaseProviderBox" Header="数据库类型" SelectedIndex="2">
                    <ComboBoxItem Content="MySQL" />
                    <ComboBoxItem Content="SQL Server" />
                    <ComboBoxItem Content="SQLite" />
                    <ComboBoxItem Content="PostgreSQL" />
                </ComboBox>
                <TextBox Header="连接字符串" Text="{x:Bind ViewModel.ConnectionString, Mode=TwoWay}" />
                <ToggleSwitch Header="自动创建数据库" IsOn="{x:Bind ViewModel.AutoCreateDatabase, Mode=TwoWay}" />
            </StackPanel>

            <TextBox Header="配置名称" Text="{x:Bind ViewModel.ConfigName, Mode=TwoWay}" />

            <TextBlock Text="配置内容 (JSON)" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBox
                Text="{x:Bind ViewModel.ConfigJson, Mode=TwoWay}"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                Height="360"
                FontFamily="Consolas" />

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="加载" Click="Load_Click" />
                <Button Content="保存" Click="Save_Click" />
                <Button Content="应用并重启" Click="Apply_Click" Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>

            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Opacity="0.8" />
        </StackPanel>
    </ScrollViewer>
</Page>
